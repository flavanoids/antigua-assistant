[Unit]
Description=Antigua TTS Server (Kokoro ONNX, primary)
After=network.target
Before=antigua-server.service

[Service]
Type=simple
WorkingDirectory=@ANTIGUA_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@ANTIGUA_DIR@/venv/bin/python3 @ANTIGUA_DIR@/server/kokoro_tts_server_flask.py --host 127.0.0.1 --port 5500 --models-dir @ANTIGUA_DIR@/models
Restart=always
RestartSec=5
StandardOutput=append:@ANTIGUA_DIR@/logs/tts_server.log
StandardError=append:@ANTIGUA_DIR@/logs/tts_server.log

[Install]
WantedBy=multi-user.target

# Copy to deploy.env (git-ignored) for deploy_fallback.sh.
FALLBACK_SSH=root@backup-box            # ssh target of the backup server
FALLBACK_DIR=/opt/antigua-fallback      # where the fallback stack lives there
FALLBACK_TTS_DIR=/opt/antigua-tts       # backup Kokoro TTS (antigua-tts.service)
PRIMARY_IP=192.168.1.10                 # this box's LAN IP (standby bridge watches it)
FALLBACK_WG_IP=10.77.0.3                # backup box on wg0 (network/README.md)

# Installed on the backup by server/scripts/deploy_fallback.sh
[Unit]
Description=Antigua Kitchen Mic Bridge — standby (takes the reSpeaker when the primary is down)
After=network-online.target antigua-fallback.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ANTIGUA_DIR@/kitchen-mic/bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=@ANTIGUA_DIR@/kitchen-mic/bridge/venv/bin/python3 @ANTIGUA_DIR@/kitchen-mic/bridge/kitchen_bridge.py
Restart=always
RestartSec=5
StandardOutput=append:@ANTIGUA_DIR@/logs/kitchen-bridge.log
StandardError=append:@ANTIGUA_DIR@/logs/kitchen-bridge.log

[Install]
WantedBy=multi-user.target

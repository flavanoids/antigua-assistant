# Copy to hosts.conf (git-ignored) for wg-mesh.sh. One host per line:
# name       ssh-target       lan-ip        wg-ip      guarded-tcp-ports  services-using-the-tunnel  mqtt-users
# ssh-target: "local" for the box you run it on, "root@host" for root ssh,
# anything else is ssh'd to and run with sudo.
# mqtt-users: the accounts on that host allowed to connect to the MQTT broker
# (the host guarding 1883); any other account gets a reset. Optional, default
# root. Add the user of every MQTT client on the host (pineda-web runs as
# pineda; the satellite, shairport-sync and the AirPlay bridge as the Pi user).
primary      local            192.168.1.10  10.77.0.1  9393,11434  antigua-server,kitchen-bridge  root,pineda
satellite    satellite        192.168.1.11  10.77.0.2  1883  antigua-satellite  root,pi
backup       root@backup-box  192.168.1.12  10.77.0.3  9394  antigua-fallback,kitchen-bridge-standby  root,pineda
